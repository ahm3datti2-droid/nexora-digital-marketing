{
  // NEXORA Digital Marketing — Cloudflare Pages configuration
  // Build command: npm run build   |   Output directory: dist
  // src/worker.js is copied to dist/_worker.js (Pages "advanced mode"),
  // so it handles /api/* and serves the static site through env.ASSETS.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexora-digital-marketing",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-09-01",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexora-db",
      "database_id": "82afcaa3-cde4-4026-a7ac-f1b908d79871",
      "migrations_dir": "migrations"
    }
  ],

  // Uploaded images (portfolio, case studies) — served at /media/<key>
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nexora-media"
    }
  ]

  // No secrets are needed. Admin credentials live (hashed) in D1.
}
